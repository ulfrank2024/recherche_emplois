# Copier ce fichier en .env (local, jamais commite) et remplir les valeurs reelles.
# Sur Vercel : memes variables a definir dans les reglages du projet (Settings > Environment Variables).

# Chaine de connexion Neon (Postgres). Recuperee dans le dashboard Neon du projet
# (Connection Details > Pooled connection). Mettre la valeur entre guillemets :
# l'URL contient souvent un "&" (ex: ?sslmode=require&channel_binding=require)
# qui casse un `source .env` en bash si elle n'est pas quotee.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Cle API Claude, utilisee par le script local de generation CV/lettre (scripts/generer-cv-lettre/).
ANTHROPIC_API_KEY=

# Mot de passe simple protegeant le dashboard en ligne (cahier des charges, section 8).
DASHBOARD_PASSWORD=
